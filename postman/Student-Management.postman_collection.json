{
  "info": {
    "_postman_id": "student-management-collection",
    "name": "Student Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman tests for the Student Management REST API. Import this collection + the environment file, then run the requests in order."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Students",
      "item": [
        {
          "name": "Add Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Satyam\",\n  \"email\": \"satyam@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "POST /api/students - creates a new student (expects 201)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response body has an id\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.collectionVariables.set(\"studentId\", String(json.id));",
                  "});",
                  "pm.test(\"Name matches\", function () {",
                  "    pm.expect(pm.response.json().name).to.eql(\"Satyam\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "GET /api/students - lists all students (expects 200)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}"]
            },
            "description": "GET /api/students/{id} - fetches a student by id (expects 200)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returned id matches\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Number(json.id)).to.eql(Number(pm.collectionVariables.get(\"studentId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Satyam Singh\",\n  \"email\": \"satyam@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 21\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}"]
            },
            "description": "PUT /api/students/{id} - updates a student (expects 200)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Name updated\", function () {",
                  "    pm.expect(pm.response.json().name).to.eql(\"Satyam Singh\");",
                  "});",
                  "pm.test(\"Age updated\", function () {",
                  "    pm.expect(pm.response.json().age).to.eql(21);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}"]
            },
            "description": "DELETE /api/students/{id} - deletes a student (expects 204)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "pm.collectionVariables.unset(\"studentId\");"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Students by Course",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students/course/Computer%20Science",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "course", "Computer Science"]
            },
            "description": "GET /api/students/course/{course} - filters students by course (expects 200)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Get Non-Existent Student -> 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "999"]
            },
            "description": "GET /api/students/999 - student not found (expects 404)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Body is an ErrorResponse\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(404);",
                  "    pm.expect(json.error).to.eql(\"Not Found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Student with Invalid Email -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad\",\n  \"email\": \"bad\",\n  \"course\": \"Math\",\n  \"age\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "POST /api/students with \"email\": \"bad\" - validation error (expects 400)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Field error reported for email\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.fieldErrors.email).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Duplicate Email -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dup\",\n  \"email\": \"satyam@example.com\",\n  \"course\": \"Math\",\n  \"age\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "POST /api/students with the same email as \"Add Student\" - duplicate (expects 409)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Body is a conflict ErrorResponse\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(409);",
                  "    pm.expect(json.error).to.eql(\"Conflict\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
